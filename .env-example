# workflow-connectors — local environment (copy to .env: `make setup` does it).
#
# This module is a library: it has no runtime configuration of its own and no
# APP_*/OTEL_*/SQS_* service settings. What is configured here is the local
# development and test environment:
#   - private module access,
#   - the docker-compose.yml integration stack (host ports),
#   - the TEST_* variables the integration tests read,
#   - the PostgreSQL settings platform-pgcommon reads (pgcommon.ConfigFromEnv /
#     MigrationDSNFromEnv) — the same variables a worker that embeds this
#     library uses, pointed at the compose stack.
#
# The Makefile includes .env (`-include .env`) and docker compose reads it for
# variable substitution, so the WC_* ports below drive both. To run `go test`
# directly instead of through make: `set -a; source .env; set +a`.

# Private module access (SSH key must be configured for git@github.com)
GOPRIVATE=github.com/BCBP-SOLUTIONS-FZC-LLC/*
GONOSUMDB=github.com/BCBP-SOLUTIONS-FZC-LLC/*

# docker-compose.yml host ports (make docker-up). Chosen not to collide with
# the IAM services' stacks (5432-5434, 6379, 4566-4569).
WC_PG_PORT=55432
WC_PGBOUNCER_PORT=55433
WC_VALKEY_PORT=56379
WC_FLOCI_PORT=4580
# Registry the compose images (and the Valkey restart tests' containers) are
# pulled from; images are pinned by digest. CI uses mirror.gcr.io (Google's
# Docker Hub mirror) to avoid Docker Hub's anonymous pull rate limit.
WC_REGISTRY=docker.io

# Integration tests (test/postgres, test/integration, and the infrastructure
# legs of ./pkg/...). The Makefile's test-postgres / test-integration / test /
# test-ci targets set these itself from the WC_* ports; they are listed for
# running `go test -tags integration` directly. Unset, the tests skip — unless
# CI is set, in which case they fail rather than skip.
# PostgreSQL direct (migrations, the document registry and send-intent stores).
TEST_POSTGRES_DSN=postgres://postgres:test@localhost:55432/connectors?sslmode=disable
# PostgreSQL through PgBouncer in transaction mode (the stores under PG_BOUNCER_MODE).
TEST_PGBOUNCER_DSN=postgres://postgres:test@localhost:55433/connectors?sslmode=disable
# Valkey with appendonly yes / appendfsync always / maxmemory-policy noeviction
# (document-reference metadata).
TEST_VALKEY_ADDR=localhost:56379
# 1 = the Valkey restart tests may start and restart their own containers.
TEST_VALKEY_DOCKER=1
# floci S3 (document content).
TEST_S3_ENDPOINT=http://localhost:4580
# CI=true makes every infrastructure test mandatory (fail, never skip). Leave
# unset locally; GitHub Actions sets it.
# CI=true

# PostgreSQL — platform-pgcommon (pgcommon.ConfigFromEnv). All database
# access goes through pgcommon; these are its variables, set for the compose
# stack through PgBouncer, as a worker would run.
# DATABASE_URL, when set, takes precedence over the PG_* variables.
DATABASE_URL=
PG_HOST=localhost
PG_PORT=55433
PG_USER=postgres
PG_PASSWORD=test
PG_DBNAME=connectors
PG_SSLMODE=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=0
# Simple-query protocol, required behind PgBouncer in transaction mode.
PG_BOUNCER_MODE=true
PG_SLOW_QUERY_THRESHOLD=200ms
# Applied per transaction (SET LOCAL) by pgcommon — they hold behind
# PgBouncer, unlike a DSN option. Both stores run every statement in a
# transaction pgcommon opens (RunInTx), so these bound every store call. Not
# applied to migrations.
PG_STATEMENT_TIMEOUT=5s
PG_LOCK_TIMEOUT=2s
# "pool" label on pgcommon's Prometheus metrics.
PG_POOL_NAME=connectors

# Migrations (documents/sqlstore.ApplySchema, sendintent/sqlstore.ApplySchema
# via migrate.Runner{DSN: pgcommon.MigrationDSNFromEnv()}): a direct
# PostgreSQL connection, never PgBouncer — the migrate runner takes a
# session-scoped advisory lock that breaks under transaction pooling.
MIGRATION_DATABASE_URL=postgres://postgres:test@localhost:55432/connectors?sslmode=disable

# Valkey and the S3 document bucket are not read from the environment by this
# library: the worker builds the go-redis and S3 clients and passes them in
# (docref.NewService(valkeystore.New(...), s3content.New(...))). Their
# required settings — appendonly/appendfsync/noeviction, the bucket, its
# lifecycle rule and IAM — are in docs/runbooks/document-refs.md. For the
# compose stack: Valkey localhost:56379, floci S3 http://localhost:4580 with
# the dev bucket workflow-connectors-documents (scripts/init-floci.sh).
